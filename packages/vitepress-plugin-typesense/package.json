{
  "name": "vitepress-plugin-typesense",
  "description": "A VitePress plugin that adds Typesense DocSearch for fast, typo-tolerant documentation search.",
  "author": "typesense",
  "type": "module",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp Search.vue SearchButton.vue dist/",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^2.0.0-alpha.15"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "gray-matter": "^4.0.3",
    "typesense": "^2.1.0",
    "typesense-docsearch-css": "^0.4.1",
    "typesense-docsearch.js": "^3.4.1"
  },
  "homepage": "https://github.com/typesense/vitepress-plugin-typesense",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesense/vitepress-plugin-typesense.git",
    "directory": "packages/vitepress-plugin-typesense"
  },
  "bugs": "https://github.com/typesense/vitepress-plugin-typesense/issues"
}
