{
  "name": "vitepress-plugin-typesense-monorepo",
  "description": "A VitePress plugin that adds Typesense DocSearch for fast, typo-tolerant documentation search.",
  "author": "typesense",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^20.3.0 || >=21.0.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "plugin:build": "cd packages/vitepress-plugin-typesense && bun run build",
    "plugin:publish": "cd packages/vitepress-plugin-typesense && npm publish"
  },
  "dependencies": {
    "vitepress-plugin-typesense": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "vitepress": "^2.0.0-alpha.15"
  },
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://github.com/typesense/vitepress-plugin-typesense",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesense/vitepress-plugin-typesense.git"
  },
  "bugs": "https://github.com/typesense/vitepress-plugin-typesense/issues"
}
